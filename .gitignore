# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# Ausgaben des Scans (koennen personenbezogene Daten enthalten)
ausgabe/
ausgabe*/
*.apk

# Reputationscache
.cache/

# Android / Gradle
testapp/.gradle/
testapp/build/
testapp/app/build/
testapp/local.properties
testapp/.idea/
testapp/*.keystore
testapp/*.jks

# App-Konfiguration mit Server-Zugangsdaten (nur Vorlage wird versioniert)
testapp/app/chat.properties
testapp/keystore.properties
# Hinweis: res/raw/relay_cert.pem (nur oeffentliches Zertifikat, kein Geheimnis)
# wird als Platzhalter mitgeliefert, damit der Build sofort funktioniert, und von
# der Ausgabe aus relay/install.sh ueberschrieben. Der private Schluessel bleibt
# ausschliesslich auf dem Server.

# Relay-Server-Geheimnisse
relay/*.pem
relay/token.txt

# Betriebssystem
Thumbs.db
.DS_Store

# pytest projektlokales Temp
.pytest_tmp/
.pytest_cache/

# Verteilungsarchive
*.zip

# PyInstaller
*.spec
