<?xml version="1.0" encoding="utf-8"?>
<!-- Kein Klartextverkehr; Vertrauen/Pinning fuer das selbstsignierte Relay-Zertifikat
     erfolgt zusaetzlich im Code (OkHttp CertificatePinner + eigener TrustManager). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
